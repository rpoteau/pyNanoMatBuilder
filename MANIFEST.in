include README.md
include ChangeLog.md
include CITATION.cff
include pyproject.toml
include MANIFEST.in
include LICENSE

# Include documentation sources (generated HTML is excluded below)
recursive-include docs *

# Include all package files (source code and resources)
recursive-include pyNanoMatBuilder *

# Include example notebooks
include *.ipynb

# Exclude build artifacts and generated documentation
prune build
prune dist
prune docs/build

# Exclude developer-only files
exclude CLAUDE.md

# Exclude Python compilation files, backups and temporary files
# (kept at the end so that no include rule re-adds them)
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *dev.py
global-exclude *.org *.tmp
